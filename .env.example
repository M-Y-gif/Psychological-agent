# 复制为 .env 并填写（.env 已被 gitignore，不会提交）
# 对话模型：DeepSeek（注意：AI_BASE_URL 不要带 /v1）
AI_API_KEY=sk-你的DeepSeekKey
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-chat

# 可选：真实 SMTP 发邮件（不配则演示模式落盘 data/emails/）
# WARNING_MAIL_ENABLED=true
# WARNING_MAIL_TO=consultant@example.com
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=xxx
# SPRING_MAIL_PASSWORD=xxx
